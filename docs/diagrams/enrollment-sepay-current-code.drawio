<mxCell id="c26" value="Ignored events do not change stored enrollment state. EXPIRED stays EXPIRED.&#10;Invalid API key/body is rejected before business processing (401/400).&#10;ACTIVE or previously successful registrations ignore duplicate payment events." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;strokeColor=#111111;strokeWidth=1.4;fillColor=#EFF8FC;shape=note;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="55" y="1090" width="740" height="100" as="geometry"/></mxCell>
<mxCell id="c27" value="Time check uses transactionDate from SePay:&#10;floor(registeredAt to minute) ≤ bankTime &lt; expiresAt, and bankTime ≤ now.&#10;paidAt stores the LMS confirmation time, not bankTime.&#10;A new registration may be created after expiry; an unexpired PENDING is reused." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;strokeColor=#111111;strokeWidth=1.4;fillColor=#EFF8FC;shape=note;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="850" y="1090" width="735" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram>
