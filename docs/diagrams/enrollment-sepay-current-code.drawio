<mxCell id="c35" value="16. Find student, lock student/registration, check duplicate" style="html=0;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#111111;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1330" as="sourcePoint"/><mxPoint x="1170" y="1330" as="targetPoint"/></mxGeometry></mxCell>
