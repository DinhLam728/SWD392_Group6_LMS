<mxCell id="c37" value="alt [valid new payment] mark SUCCESS and paidAt = backend confirmation time;&#10;activate if no ACTIVE exists; expire other PENDING registrations.&#10;else ignore notification. Invalid authentication/body returns 401/400." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;strokeColor=#111111;strokeWidth=1.4;fillColor=#EFF8FC;shape=note;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="420" y="1430" width="1050" height="100" as="geometry"/></mxCell>
<mxCell id="c38" value="18. Commit payment and enrollment changes [valid]" style="html=0;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#111111;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="1570" as="sourcePoint"/><mxPoint x="1170" y="1570" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c39" value="19. HTTP 200 {success: true} [authenticated valid body]" style="html=0;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#111111;endArrow=block;endFill=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="1625" as="sourcePoint"/><mxPoint x="1720" y="1625" as="targetPoint"/></mxGeometry></mxCell>
