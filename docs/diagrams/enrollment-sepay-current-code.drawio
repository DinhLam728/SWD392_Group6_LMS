<mxCell id="c27" value="10. HTTP 200 + payment details" style="html=0;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#111111;endArrow=block;endFill=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="840" as="sourcePoint"/><mxPoint x="100" y="840" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c28" value="11. Browser GET qrUrl; scan and transfer through banking app" style="html=0;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#111111;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="900" as="sourcePoint"/><mxPoint x="1720" y="900" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c29" value="SePayProxy constructs the URL locally. No payment-order API call is made.&#10;Student may pay later; webhook processing is asynchronous." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;strokeColor=#111111;strokeWidth=1.4;fillColor=#EFF8FC;shape=note;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="930" width="1180" height="65" as="geometry"/></mxCell>
<mxCell id="c30" value="opt [incoming transaction detected by SePay]" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;strokeColor=#111111;strokeWidth=1.4;fillColor=none;verticalAlign=top;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="35" y="1035" width="1785" height="620" as="geometry"/></mxCell>
<mxCell id="c31" value="12. POST .../registrationService/webhooks/sepay + Authorization: Apikey ..." style="html=0;fontFamily=Arial;fontSize=13;labelBackgroundColor=#FFFFFF;strokeColor=#111111;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="1090" as="sourcePoint"/><mxPoint x="360" y="1090" as="targetPoint"/></mxGeometry></mxCell>
