# Copy to backend/.env. Do not commit the .env file.
# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_g6
DB_USERNAME=root
DB_PASSWORD=
# Local MySQL: PREFERRED. TiDB Cloud: VERIFY_IDENTITY.
DB_SSL_MODE=PREFERRED
# For TiDB Cloud, copy host, port and full username from Connect.
# Keep DB_NAME=lms_g6 and use the database password created in TiDB.

# Frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gmail SMTP - use an App Password without grouping spaces
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Google Login - same Client ID as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# SePay - receiving account linked in Live, or a Test mode account
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
# Leave empty unless required by your bank / virtual account setup
SEPAY_TRANSFER_PREFIX=
SEPAY_SUB_ACCOUNT=
SEPAY_DEMO_PAYMENT=true

# Google AI Studio key. Put the real value in backend/.env only, never in this file.
GEMINI_API_KEY=
# Optional: seconds to wait for Gemini (default 45).
# GEMINI_TIMEOUT_SECONDS=45