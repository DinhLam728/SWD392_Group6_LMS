# Append these keys to backend/.env; keep existing DB keys.
SEPAY_BANK=Vietcombank
SEPAY_ACCOUNT_NUMBER=replace-with-your-receiving-account
SEPAY_ACCOUNT_NAME=replace-with-account-holder
SEPAY_WEBHOOK_API_KEY=replace-with-a-random-secret
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
# Optional bank-specific transfer prefix / virtual subaccount.
SEPAY_TRANSFER_PREFIX=
SEPAY_SUB_ACCOUNT=
